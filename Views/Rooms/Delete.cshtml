@model HotelReservationSystem1.Models.Room
@{
    ViewData["Title"] = "Delete Room";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-danger">
                <div class="card-body">
                    <h2 class="card-title text-danger mb-4">Delete Room</h2>
                    <h5>Are you sure you want to delete this room?</h5>
                    <hr />
                    
                    <dl class="row">
                        <dt class="col-sm-3">Room Number</dt>
                        <dd class="col-sm-9">@Model.RoomNumber</dd>
                        
                        <dt class="col-sm-3">Room Type</dt>
                        <dd class="col-sm-9">@Model.RoomType</dd>
                        
                        <dt class="col-sm-3">Capacity</dt>
                        <dd class="col-sm-9">@Model.Capacity persons</dd>
                        
                        <dt class="col-sm-3">Price Per Night</dt>
                        <dd class="col-sm-9">$@Model.PricePerNight</dd>
                    </dl>
                    
                    <form asp-action="Delete">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger">Delete</button>
                            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
