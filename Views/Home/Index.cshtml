@model IEnumerable<HotelReservationSystem1.Models.Room>
@using HotelReservationSystem1.Helpers
@{
    ViewData["Title"] = "Home";
}

<div class="hero-section bg-primary text-white text-center py-5 mb-5">
    <div class="container">
        <h1 class="display-3 fw-bold">Welcome to Our Hotel</h1>
        <p class="lead">Experience luxury and comfort at its finest</p>
        <a asp-controller="Rooms" asp-action="Index" class="btn btn-light btn-lg mt-3">View All Rooms</a>
    </div>
</div>

<div class="container">
    <div class="row mb-4">
        <div class="col-md-12 text-center">
            <h2 class="mb-4">Featured Rooms</h2>
            <p class="text-muted">Discover our most popular accommodations</p>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row">
            @foreach (var room in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm hover-shadow">
                        @if (!string.IsNullOrEmpty(room.ImageUrl))
                        {
                            <img src="@room.ImageUrl" class="card-img-top" alt="@room.RoomNumber" style="height: 200px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="bg-secondary text-white d-flex align-items-center justify-content-center" style="height: 200px;">
                                <span class="fs-3">Room @room.RoomNumber</span>
                            </div>
                        }
                        <div class="card-body">
                            <h5 class="card-title">@room.RoomType Room</h5>
                            <p class="card-text">
                                <i class="bi bi-people"></i> Capacity: @room.Capacity persons<br />
                                <i class="bi bi-cash"></i> @CurrencyHelper.FormatPeso(room.PricePerNight) per night
                            </p>
                            @if (!string.IsNullOrEmpty(room.Description))
                            {
                                <p class="card-text text-muted small">@room.Description</p>
                            }
                        </div>
                        <div class="card-footer bg-transparent">
                            <div class="d-flex gap-2">
                                <a asp-controller="Rooms" asp-action="Details" asp-route-id="@room.Id" class="btn btn-outline-primary flex-fill">View Details</a>
                                @if (User.Identity!.IsAuthenticated)
                                {
                                    <a asp-controller="Reservations" asp-action="Create" asp-route-roomId="@room.Id" class="btn btn-primary flex-fill">Book Now</a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
        
        <div class="text-center mt-4">
            <a asp-controller="Rooms" asp-action="Index" class="btn btn-primary btn-lg">View All Rooms</a>
        </div>
    }
    else
    {
        <div class="alert alert-info text-center">
            <p class="mb-0">No rooms available at the moment. Please check back later.</p>
        </div>
    }

    <div class="row mt-5 mb-5">
        <div class="col-md-4 text-center">
            <div class="p-4">
                <div class="display-4 text-primary mb-3">🏨</div>
                <h4>Luxury Accommodation</h4>
                <p class="text-muted">Experience comfort and elegance in our well-appointed rooms</p>
            </div>
        </div>
        <div class="col-md-4 text-center">
            <div class="p-4">
                <div class="display-4 text-primary mb-3">⭐</div>
                <h4>Premium Service</h4>
                <p class="text-muted">Our dedicated staff is here to make your stay memorable</p>
            </div>
        </div>
        <div class="col-md-4 text-center">
            <div class="p-4">
                <div class="display-4 text-primary mb-3">📍</div>
                <h4>Prime Location</h4>
                <p class="text-muted">Conveniently located near major attractions and business centers</p>
            </div>
        </div>
    </div>
</div>

<style>
    .hero-section {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }
    
    .hover-shadow {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    
    .hover-shadow:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.2) !important;
    }
</style>
