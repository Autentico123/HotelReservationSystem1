<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Carmen Grand Hotel - @(User.IsInRole("Staff") ? "Staff Panel" : "Admin Panel")</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HotelReservationSystem1.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
</head>
<body>
    <div class="wrapper d-flex">
        <!-- Sidebar -->
        <aside id="sidebar" class="sidebar">
            <div class="sidebar-header">
                <a href="@Url.Action("Dashboard", "Admin")" class="sidebar-brand">
                    @if (User.IsInRole("Admin"))
                    {
                        <i class="bi bi-shield-lock-fill"></i>
                        <span>CGH Admin</span>
                    }
                    else if (User.IsInRole("Staff"))
                    {
                        <i class="bi bi-person-badge-fill"></i>
                        <span>CGH Staff</span>
                    }
                    else
                    {
                        <i class="bi bi-shield-lock-fill"></i>
                        <span>CGH Panel</span>
                    }
                </a>
                <button class="sidebar-toggle btn btn-link d-lg-none" id="sidebarToggle">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <ul class="sidebar-nav">
                <li class="sidebar-item">
                    <a asp-controller="Admin" asp-action="Dashboard" class="sidebar-link">
                        <i class="bi bi-speedometer2"></i>
                        <span>Dashboard</span>
                    </a>
                </li>
                
                <li class="sidebar-header">
                    Management
                </li>
                
                <li class="sidebar-item">
                    <a asp-controller="Admin" asp-action="Rooms" class="sidebar-link">
                        <i class="bi bi-door-open"></i>
                        <span>Rooms</span>
                    </a>
                </li>
                
                <li class="sidebar-item">
                    <a asp-controller="Admin" asp-action="Reservations" class="sidebar-link">
                        <i class="bi bi-calendar-check"></i>
                        <span>Reservations</span>
                    </a>
                </li>
                
                @if (User.IsInRole("Admin"))
                {
                    <li class="sidebar-item">
                        <a asp-controller="Admin" asp-action="Users" class="sidebar-link">
                            <i class="bi bi-people"></i>
                            <span>Users</span>
                        </a>
                    </li>
                }
                
                <li class="sidebar-header">
                    Reports & Analytics
                </li>
                
                <li class="sidebar-item">
                    <a asp-controller="Admin" asp-action="Reports" class="sidebar-link">
                        <i class="bi bi-graph-up"></i>
                        <span>Reports</span>
                    </a>
                </li>
                
                <li class="sidebar-header">
                    Quick Actions
                </li>
                
                <li class="sidebar-item">
                    <a asp-controller="Rooms" asp-action="Create" class="sidebar-link">
                        <i class="bi bi-plus-circle"></i>
                        <span>Add New Room</span>
                    </a>
                </li>
                
                <li class="sidebar-header">
                    Main Site
                </li>
                
                <li class="sidebar-item">
                    <a asp-controller="Home" asp-action="Index" class="sidebar-link">
                        <i class="bi bi-house-door"></i>
                        <span>View Public Site</span>
                    </a>
                </li>
            </ul>

            <div class="sidebar-footer">
                <div class="user-info">
                    <i class="bi bi-person-circle"></i>
                    <span>@User.Identity!.Name</span>
                    @if (User.IsInRole("Admin"))
                    {
                        <span class="badge bg-danger ms-2">Admin</span>
                    }
                    else if (User.IsInRole("Staff"))
                    {
                        <span class="badge bg-warning ms-2">Staff</span>
                    }
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                    <button type="submit" class="btn btn-sm btn-outline-light w-100">
                        <i class="bi bi-box-arrow-right"></i> Logout
                    </button>
                </form>
            </div>
        </aside>

        <!-- Main Content -->
        <div class="main-content flex-fill">
            <!-- Top Navbar -->
            <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom">
                <div class="container-fluid">
                    <button class="btn btn-link d-lg-none" id="sidebarToggleMobile">
                        <i class="bi bi-list fs-3"></i>
                    </button>
                    
                    <span class="navbar-text ms-3">
                        <strong>@ViewData["Title"]</strong>
                    </span>

                    <div class="ms-auto d-flex align-items-center">
                        <span class="me-3 text-muted">
                            <i class="bi bi-clock"></i>
                            <span id="currentTime"></span>
                        </span>
                        <div class="dropdown">
                            <button class="btn btn-link dropdown-toggle" type="button" id="userDropdown" 
                                    data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle fs-4"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                <li><a class="dropdown-item" asp-controller="Home" asp-action="Index">
                                    <i class="bi bi-house-door"></i> View Site
                                </a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        <button type="submit" class="dropdown-item">
                                            <i class="bi bi-box-arrow-right"></i> Logout
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </nav>

            <!-- Page Content -->
            <div class="content-wrapper p-4">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle-fill"></i> @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @RenderBody()
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/admin.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
