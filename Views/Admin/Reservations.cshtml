@model List<HotelReservationSystem1.Models.Reservation>
@using HotelReservationSystem1.Helpers
@{
    ViewData["Title"] = "Reservations Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var currentStatus = ViewBag.CurrentStatus as string ?? "all";
}

<!-- Print Header (Hidden on screen, visible on print) -->
<div class="print-header">
    <h1>Carmen Grand Hotel - Reservations Report</h1>
    <p>Generated on: @DateTime.Now.ToString("MMMM dd, yyyy hh:mm tt")</p>
    <p>Filter: @(currentStatus == "all" ? "All Reservations" : currentStatus + " Reservations")</p>
    <p>Carmen, Bohol | Phone: +639123478567 | Email: info@carmengrandhotel.com</p>
</div>

<div class="fade-in">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-0">Reservations Management</h2>
            <p class="text-muted mb-0">View and manage all reservations</p>
        </div>
        <div class="no-print">
            <button onclick="window.print()" class="btn print-button">
                <i class="bi bi-printer-fill"></i> Print Report
            </button>
        </div>
    </div>

    <!-- Filter Tabs -->
    <ul class="nav nav-pills mb-4">
        <li class="nav-item">
            <a class="nav-link @(currentStatus == "all" ? "active" : "")" 
               asp-controller="Admin" asp-action="Reservations" asp-route-status="all">
                All Reservations
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(currentStatus == "confirmed" ? "active" : "")" 
               asp-controller="Admin" asp-action="Reservations" asp-route-status="confirmed">
                <span class="badge bg-success">?</span> Confirmed
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(currentStatus == "pending" ? "active" : "")" 
               asp-controller="Admin" asp-action="Reservations" asp-route-status="pending">
                <span class="badge bg-warning">?</span> Pending
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(currentStatus == "cancelled" ? "active" : "")" 
               asp-controller="Admin" asp-action="Reservations" asp-route-status="cancelled">
                <span class="badge bg-danger">?</span> Cancelled
            </a>
        </li>
    </ul>

    <!-- Reservations Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table admin-table mb-0">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Guest</th>
                                <th>Room</th>
                                <th>Check-in</th>
                                <th>Check-out</th>
                                <th>Nights</th>
                                <th>Guests</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th>Booked On</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var reservation in Model)
                            {
                                var nights = (reservation.CheckOutDate - reservation.CheckInDate).Days;
                                var isPast = reservation.CheckOutDate < DateTime.Today;
                                var isActive = reservation.CheckInDate <= DateTime.Today && reservation.CheckOutDate >= DateTime.Today;
                                
                                <tr>
                                    <td><strong>#@reservation.Id</strong></td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <i class="bi bi-person-circle fs-4 text-muted me-2"></i>
                                            <div>
                                                <div class="fw-bold">@reservation.User.FirstName @reservation.User.LastName</div>
                                                <small class="text-muted">@reservation.User.Email</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div>
                                            <strong>Room @reservation.Room.RoomNumber</strong>
                                            <br />
                                            <small class="text-muted">@reservation.Room.RoomType</small>
                                        </div>
                                    </td>
                                    <td>
                                        @reservation.CheckInDate.ToString("MMM dd, yyyy")
                                        @if (isActive)
                                        {
                                            <br /><span class="badge bg-info">Checked In</span>
                                        }
                                    </td>
                                    <td>@reservation.CheckOutDate.ToString("MMM dd, yyyy")</td>
                                    <td>@nights night@(nights != 1 ? "s" : "")</td>
                                    <td>@reservation.NumberOfGuests</td>
                                    <td><strong class="text-success">@CurrencyHelper.FormatPeso(reservation.TotalAmount)</strong></td>
                                    <td>
                                        @if (reservation.Status == "Confirmed")
                                        {
                                            <span class="badge bg-success badge-status">
                                                <i class="bi bi-check-circle"></i> Confirmed
                                            </span>
                                        }
                                        else if (reservation.Status == "Cancelled")
                                        {
                                            <span class="badge bg-danger badge-status">
                                                <i class="bi bi-x-circle"></i> Cancelled
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning badge-status">
                                                <i class="bi bi-clock"></i> Pending
                                            </span>
                                        }
                                        @if (isPast && reservation.Status == "Confirmed")
                                        {
                                            <br /><small class="text-muted">Completed</small>
                                        }
                                    </td>
                                    <td>@reservation.CreatedAt.ToString("MMM dd, yyyy")</td>
                                    <td>
                                        <div class="d-flex gap-1">
                                            <a asp-controller="Reservations" asp-action="Details" asp-route-id="@reservation.Id" 
                                               class="btn btn-sm btn-outline-primary action-btn"
                                               data-bs-toggle="tooltip" title="View Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-controller="Reservations" asp-action="Edit" asp-route-id="@reservation.Id" 
                                               class="btn btn-sm btn-outline-warning action-btn"
                                               data-bs-toggle="tooltip" title="Edit Reservation">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            @if (reservation.Status != "Cancelled")
                                            {
                                                <form asp-controller="Admin" asp-action="UpdateReservationStatus" method="post" class="d-inline">
                                                    <input type="hidden" name="id" value="@reservation.Id" />
                                                    <input type="hidden" name="status" value="Cancelled" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger action-btn"
                                                            data-bs-toggle="tooltip" title="Cancel Reservation"
                                                            onclick="return confirm('Are you sure you want to cancel this reservation?')">
                                                        <i class="bi bi-x-circle"></i>
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state py-5">
                    <i class="bi bi-calendar-x"></i>
                    <h5>No Reservations Found</h5>
                    <p class="mb-0">
                        @if (currentStatus == "all")
                        {
                            <text>There are no reservations in the system yet.</text>
                        }
                        else
                        {
                            <text>No @currentStatus reservations found.</text>
                        }
                    </p>
                </div>
            }
        </div>
    </div>

    <!-- Summary Stats -->
    @if (Model.Any())
    {
        var totalAmount = Model.Where(r => r.Status == "Confirmed").Sum(r => r.TotalAmount);
        var avgAmount = Model.Where(r => r.Status == "Confirmed").Any() 
            ? Model.Where(r => r.Status == "Confirmed").Average(r => r.TotalAmount) 
            : 0;
        
        <div class="row mt-4 g-3">
            <div class="col-md-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-body text-center">
                        <h6 class="text-muted mb-1">Total Reservations</h6>
                        <h3 class="mb-0">@Model.Count</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-body text-center">
                        <h6 class="text-muted mb-1">Total Revenue</h6>
                        <h3 class="mb-0 text-success">@CurrencyHelper.FormatPeso(totalAmount)</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-body text-center">
                        <h6 class="text-muted mb-1">Average Booking Value</h6>
                        <h3 class="mb-0 text-primary">@CurrencyHelper.FormatPeso(avgAmount)</h3>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
