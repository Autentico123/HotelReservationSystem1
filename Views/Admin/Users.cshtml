@model List<HotelReservationSystem1.Controllers.UserViewModel>
@{
    ViewData["Title"] = "User Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- Print Header (Hidden on screen, visible on print) -->
<div class="print-header">
    <h1>Carmen Grand Hotel - Users Report</h1>
    <p>Generated on: @DateTime.Now.ToString("MMMM dd, yyyy hh:mm tt")</p>
    <p>Carmen, Bohol | Phone: +639123478567 | Email: info@carmengrandhotel.com</p>
</div>

<div class="fade-in">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-0">User Management</h2>
            <p class="text-muted mb-0">Manage system users and roles</p>
        </div>
        <div class="no-print">
            <button onclick="window.print()" class="btn print-button me-2">
                <i class="bi bi-printer-fill"></i> Print Report
            </button>
            <a asp-action="CreateUser" class="btn btn-primary">
                <i class="bi bi-person-plus-fill"></i> Add New User
            </a>
        </div>
    </div>

    <!-- Users Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table admin-table mb-0">
                        <thead>
                            <tr>
                                <th>User</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>Roles</th>
                                <th>Reservations</th>
                                <th>Member Since</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var userViewModel in Model)
                            {
                                var user = userViewModel.User;
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center me-3"
                                                 style="width: 40px; height: 40px; font-weight: bold;">
                                                @user.FirstName.Substring(0, 1)@user.LastName.Substring(0, 1)
                                            </div>
                                            <div>
                                                <div class="fw-bold">@user.FirstName @user.LastName</div>
                                                <small class="text-muted">ID: @user.Id.Substring(0, 8)...</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <i class="bi bi-envelope text-muted me-1"></i>
                                        @user.Email
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(user.PhoneNumber))
                                        {
                                            <i class="bi bi-telephone text-muted me-1"></i>
                                            @user.PhoneNumber
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (userViewModel.Roles.Any())
                                        {
                                            @foreach (var role in userViewModel.Roles)
                                            {
                                                if (role == "Admin")
                                                {
                                                    <span class="badge bg-danger me-1">
                                                        <i class="bi bi-shield-fill"></i> @role
                                                    </span>
                                                }
                                                else if (role == "Staff")
                                                {
                                                    <span class="badge bg-warning me-1">
                                                        <i class="bi bi-person-badge"></i> @role
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-primary me-1">@role</span>
                                                }
                                            }
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">User</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-info">
                                            @userViewModel.ReservationCount booking@(userViewModel.ReservationCount != 1 ? "s" : "")
                                        </span>
                                    </td>
                                    <td>@user.CreatedAt.ToString("MMM dd, yyyy")</td>
                                    <td>
                                        <div class="d-flex gap-1">
                                            <div class="dropdown">
                                                <button class="btn btn-sm btn-outline-primary dropdown-toggle" type="button" 
                                                        data-bs-toggle="dropdown" aria-expanded="false">
                                                    <i class="bi bi-gear"></i> Manage
                                                </button>
                                                <ul class="dropdown-menu">
                                                    <li><h6 class="dropdown-header">Manage Roles</h6></li>
                                                    <li>
                                                        <form asp-controller="Admin" asp-action="ToggleUserRole" method="post" class="dropdown-item">
                                                            <input type="hidden" name="userId" value="@user.Id" />
                                                            <input type="hidden" name="role" value="Admin" />
                                                            <button type="submit" class="btn btn-link text-decoration-none p-0 text-start w-100"
                                                                    onclick="return confirm('Are you sure you want to @(userViewModel.Roles.Contains("Admin") ? "remove" : "grant") Admin role?')">
                                                                @if (userViewModel.Roles.Contains("Admin"))
                                                                {
                                                                    <i class="bi bi-dash-circle text-danger"></i> <text>Remove Admin</text>
                                                                }
                                                                else
                                                                {
                                                                    <i class="bi bi-plus-circle text-success"></i> <text>Make Admin</text>
                                                                }
                                                            </button>
                                                        </form>
                                                    </li>
                                                    <li>
                                                        <form asp-controller="Admin" asp-action="ToggleUserRole" method="post" class="dropdown-item">
                                                            <input type="hidden" name="userId" value="@user.Id" />
                                                            <input type="hidden" name="role" value="Staff" />
                                                            <button type="submit" class="btn btn-link text-decoration-none p-0 text-start w-100"
                                                                    onclick="return confirm('Are you sure you want to @(userViewModel.Roles.Contains("Staff") ? "remove" : "grant") Staff role?')">
                                                                @if (userViewModel.Roles.Contains("Staff"))
                                                                {
                                                                    <i class="bi bi-dash-circle text-danger"></i> <text>Remove Staff</text>
                                                                }
                                                                else
                                                                {
                                                                    <i class="bi bi-plus-circle text-success"></i> <text>Make Staff</text>
                                                                }
                                                            </button>
                                                        </form>
                                                    </li>
                                                    <li><hr class="dropdown-divider"></li>
                                                    <li><h6 class="dropdown-header">Danger Zone</h6></li>
                                                    <li>
                                                        @if (userViewModel.ReservationCount == 0)
                                                        {
                                                            <form asp-controller="Admin" asp-action="DeleteUser" method="post" class="dropdown-item">
                                                                <input type="hidden" name="userId" value="@user.Id" />
                                                                <button type="submit" class="btn btn-link text-decoration-none p-0 text-start w-100 text-danger"
                                                                        onclick="return confirm('Are you sure you want to delete this user? This action cannot be undone.')">
                                                                    <i class="bi bi-trash"></i> Delete User
                                                                </button>
                                                            </form>
                                                        }
                                                        else
                                                        {
                                                            <span class="dropdown-item text-muted">
                                                                <i class="bi bi-trash"></i> Cannot delete (has reservations)
                                                            </span>
                                                        }
                                                    </li>
                                                </ul>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state py-5">
                    <i class="bi bi-people"></i>
                    <h5>No Users Found</h5>
                    <p class="mb-3">There are no registered users in the system yet.</p>
                    <a asp-action="CreateUser" class="btn btn-primary">
                        <i class="bi bi-person-plus-fill"></i> Create First User
                    </a>
                </div>
            }
        </div>
    </div>

    <!-- User Statistics -->
    @if (Model.Any())
    {
        var totalUsers = Model.Count;
        var adminCount = Model.Count(u => u.Roles.Contains("Admin"));
        var staffCount = Model.Count(u => u.Roles.Contains("Staff"));
        var regularUsers = totalUsers - adminCount - staffCount;
        var totalReservations = Model.Sum(u => u.ReservationCount);
        var avgReservations = Model.Any() ? Model.Average(u => u.ReservationCount) : 0;

        <div class="row mt-4 g-3">
            <div class="col-md-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-body text-center">
                        <i class="bi bi-people fs-1 text-primary mb-2"></i>
                        <h6 class="text-muted mb-1">Total Users</h6>
                        <h3 class="mb-0">@totalUsers</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="card border-0 shadow-sm">
                    <div class="card-body text-center">
                        <i class="bi bi-shield-fill fs-1 text-danger mb-2"></i>
                        <h6 class="text-muted mb-1">Administrators</h6>
                        <h3 class="mb-0">@adminCount</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="card border-0 shadow-sm">
                    <div class="card-body text-center">
                        <i class="bi bi-person-badge fs-1 text-warning mb-2"></i>
                        <h6 class="text-muted mb-1">Staff Members</h6>
                        <h3 class="mb-0">@staffCount</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="card border-0 shadow-sm">
                    <div class="card-body text-center">
                        <i class="bi bi-person fs-1 text-success mb-2"></i>
                        <h6 class="text-muted mb-1">Regular Users</h6>
                        <h3 class="mb-0">@regularUsers</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-body text-center">
                        <i class="bi bi-calendar-check fs-1 text-info mb-2"></i>
                        <h6 class="text-muted mb-1">Avg. Bookings/User</h6>
                        <h3 class="mb-0">@avgReservations.ToString("F1")</h3>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
