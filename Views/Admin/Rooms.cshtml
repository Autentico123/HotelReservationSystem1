@model List<HotelReservationSystem1.Models.Room>
@using HotelReservationSystem1.Helpers
@{
    ViewData["Title"] = "Room Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="fade-in">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-0">Room Management</h2>
            <p class="text-muted mb-0">Manage all hotel rooms</p>
        </div>
        <div>
            <a asp-controller="Rooms" asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Add New Room
            </a>
        </div>
    </div>

    <!-- Rooms Grid -->
    <div class="row g-4">
        @foreach (var room in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card border-0 shadow-sm h-100">
                    <img src="@(string.IsNullOrEmpty(room.ImageUrl) ? "https://via.placeholder.com/400x300?text=Room+" + room.RoomNumber : room.ImageUrl)" 
                         class="card-img-top" alt="Room @room.RoomNumber" style="height: 200px; object-fit: cover;">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <h5 class="card-title mb-1">Room @room.RoomNumber</h5>
                                <p class="text-muted mb-0">@room.RoomType</p>
                            </div>
                            @if (room.IsAvailable)
                            {
                                <span class="badge bg-success">Available</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Occupied</span>
                            }
                        </div>
                        
                        <div class="mb-3">
                            <div class="d-flex align-items-center mb-2">
                                <i class="bi bi-people text-primary me-2"></i>
                                <span>Capacity: <strong>@room.Capacity</strong> guests</span>
                            </div>
                            <div class="d-flex align-items-center">
                                <i class="bi bi-cash text-success me-2"></i>
                                <span>Price: <strong>@CurrencyHelper.FormatPeso(room.PricePerNight)</strong> per night</span>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(room.Description))
                        {
                            <p class="card-text text-muted small">
                                @(room.Description.Length > 100 ? room.Description.Substring(0, 100) + "..." : room.Description)
                            </p>
                        }
                    </div>
                    <div class="card-footer bg-transparent border-top d-flex gap-2">
                        <a asp-controller="Rooms" asp-action="Details" asp-route-id="@room.Id" 
                           class="btn btn-sm btn-outline-primary flex-fill">
                            <i class="bi bi-eye"></i> View
                        </a>
                        <a asp-controller="Rooms" asp-action="Edit" asp-route-id="@room.Id" 
                           class="btn btn-sm btn-outline-secondary flex-fill">
                            <i class="bi bi-pencil"></i> Edit
                        </a>
                        <a asp-controller="Rooms" asp-action="Delete" asp-route-id="@room.Id" 
                           class="btn btn-sm btn-outline-danger flex-fill">
                            <i class="bi bi-trash"></i> Delete
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (Model.Count == 0)
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="empty-state">
                    <i class="bi bi-door-closed"></i>
                    <h5>No Rooms Found</h5>
                    <p class="mb-3">Get started by adding your first room</p>
                    <a asp-controller="Rooms" asp-action="Create" class="btn btn-primary">
                        <i class="bi bi-plus-circle"></i> Add New Room
                    </a>
                </div>
            </div>
        </div>
    }
</div>
