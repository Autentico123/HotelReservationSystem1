@model HotelReservationSystem1.Models.Reservation
@using HotelReservationSystem1.Helpers
@{
    ViewData["Title"] = "Edit Reservation";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h2 class="card-title mb-0">
                            <i class="bi bi-pencil-square"></i> Edit Reservation #@Model.Id
                        </h2>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i> Back to List
                        </a>
                    </div>

                    @if (ViewData.ModelState.ErrorCount > 0)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <strong><i class="bi bi-exclamation-triangle"></i> Please fix the following errors:</strong>
                            <ul class="mb-0 mt-2">
                                @foreach (var modelState in ViewData.ModelState.Values)
                                {
                                    foreach (var error in modelState.Errors)
                                    {
                                        <li>@error.ErrorMessage</li>
                                    }
                                }
                            </ul>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <!-- Current Reservation Info -->
                    <div class="card bg-light mb-4">
                        <div class="card-body">
                            <h6 class="card-title"><i class="bi bi-info-circle"></i> Current Reservation Details</h6>
                            <div class="row">
                                <div class="col-md-6">
                                    <p class="mb-1"><strong>Guest:</strong> @Model.User?.FirstName @Model.User?.LastName</p>
                                    <p class="mb-1"><strong>Email:</strong> @Model.User?.Email</p>
                                </div>
                                <div class="col-md-6">
                                    <p class="mb-1"><strong>Current Status:</strong> 
                                        @if (Model.Status == "Confirmed")
                                        {
                                            <span class="badge bg-success">Confirmed</span>
                                        }
                                        else if (Model.Status == "Cancelled")
                                        {
                                            <span class="badge bg-danger">Cancelled</span>
                                        }
                                        else if (Model.Status == "Completed")
                                        {
                                            <span class="badge bg-info">Completed</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning">Pending</span>
                                        }
                                    </p>
                                    <p class="mb-0"><strong>Booked On:</strong> @Model.CreatedAt.ToString("MMM dd, yyyy hh:mm tt")</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <form asp-action="Edit" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="UserId" />
                        <input type="hidden" asp-for="CreatedAt" />
                        
                        <div class="row">
                            <!-- Room Selection -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="RoomId" class="form-label">
                                    <i class="bi bi-door-open"></i> Room
                                </label>
                                <select asp-for="RoomId" class="form-select" asp-items="ViewBag.RoomId" id="roomSelect">
                                    <option value="">-- Select a Room --</option>
                                </select>
                                <span asp-validation-for="RoomId" class="text-danger"></span>
                                <small class="form-text text-muted">Current: Room @Model.Room?.RoomNumber (@Model.Room?.RoomType)</small>
                            </div>

                            <!-- Status Selection -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="Status" class="form-label">
                                    <i class="bi bi-bookmark"></i> Status
                                </label>
                                <select asp-for="Status" class="form-select">
                                    <option value="Pending">Pending</option>
                                    <option value="Confirmed">Confirmed</option>
                                    <option value="Cancelled">Cancelled</option>
                                    <option value="Completed">Completed</option>
                                </select>
                                <span asp-validation-for="Status" class="text-danger"></span>
                                <small class="form-text text-muted">Change booking status</small>
                            </div>
                        </div>
                        
                        <!-- Check-in and Check-out Dates -->
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="CheckInDate" class="form-label">
                                    <i class="bi bi-calendar-plus"></i> Check-in Date
                                </label>
                                <input asp-for="CheckInDate" class="form-control" type="date" id="checkInDate" />
                                <span asp-validation-for="CheckInDate" class="text-danger"></span>
                            </div>
                            
                            <div class="col-md-6 mb-3">
                                <label asp-for="CheckOutDate" class="form-label">
                                    <i class="bi bi-calendar-minus"></i> Check-out Date
                                </label>
                                <input asp-for="CheckOutDate" class="form-control" type="date" id="checkOutDate" />
                                <span asp-validation-for="CheckOutDate" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <!-- Number of Guests -->
                            <div class="col-md-4 mb-3">
                                <label asp-for="NumberOfGuests" class="form-label">
                                    <i class="bi bi-people"></i> Number of Guests
                                </label>
                                <input asp-for="NumberOfGuests" class="form-control" type="number" min="1" />
                                <span asp-validation-for="NumberOfGuests" class="text-danger"></span>
                            </div>

                            <!-- Total Amount -->
                            <div class="col-md-4 mb-3">
                                <label asp-for="TotalAmount" class="form-label">
                                    <i class="bi bi-cash-stack"></i> Total Amount
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">?</span>
                                    <input asp-for="TotalAmount" class="form-control" type="number" step="0.01" min="0" />
                                </div>
                                <span asp-validation-for="TotalAmount" class="text-danger"></span>
                                <small class="form-text text-muted">Auto-calculated when dates change</small>
                            </div>

                            <!-- Nights Display -->
                            <div class="col-md-4 mb-3">
                                <label class="form-label">
                                    <i class="bi bi-moon-stars"></i> Number of Nights
                                </label>
                                <div class="form-control-plaintext">
                                    <strong id="nightsDisplay">-</strong>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Special Requests -->
                        <div class="mb-3">
                            <label asp-for="SpecialRequests" class="form-label">
                                <i class="bi bi-chat-left-text"></i> Special Requests
                            </label>
                            <textarea asp-for="SpecialRequests" class="form-control" rows="3" 
                                      placeholder="Any special requests or notes..."></textarea>
                            <span asp-validation-for="SpecialRequests" class="text-danger"></span>
                        </div>

                        <!-- Price Calculation Card -->
                        <div class="card bg-info bg-opacity-10 border-info mb-3">
                            <div class="card-body">
                                <h6 class="card-title">
                                    <i class="bi bi-calculator"></i> Price Calculation
                                </h6>
                                <div class="row">
                                    <div class="col-md-4">
                                        <small class="text-muted">Room Price/Night:</small>
                                        <div id="pricePerNight" class="fw-bold">-</div>
                                    </div>
                                    <div class="col-md-4">
                                        <small class="text-muted">Number of Nights:</small>
                                        <div id="nightsDisplay2" class="fw-bold">-</div>
                                    </div>
                                    <div class="col-md-4">
                                        <small class="text-muted">Calculated Total:</small>
                                        <div id="calculatedTotal" class="fw-bold text-success">-</div>
                                    </div>
                                </div>
                                <small class="text-muted">
                                    <i class="bi bi-info-circle"></i> Total amount will be auto-calculated based on dates and room price
                                </small>
                            </div>
                        </div>
                        
                        <!-- Action Buttons -->
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-check-circle"></i> Save Changes
                            </button>
                            <a asp-action="Index" class="btn btn-secondary btn-lg">
                                <i class="bi bi-x-circle"></i> Cancel
                            </a>
                            @if (Model.Status != "Cancelled")
                            {
                                <button type="button" class="btn btn-danger btn-lg ms-auto" 
                                        onclick="if(confirm('Are you sure you want to cancel this reservation?')) { document.getElementById('cancelForm').submit(); }">
                                    <i class="bi bi-trash"></i> Cancel Reservation
                                </button>
                            }
                        </div>
                    </form>

                    <!-- Hidden Cancel Form -->
                    @if (Model.Status != "Cancelled")
                    {
                        <form asp-action="Cancel" method="post" id="cancelForm" style="display: none;">
                            <input type="hidden" name="id" value="@Model.Id" />
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        // Store room data from server
        const rooms = @Html.Raw(Json.Serialize(ViewBag.AllRooms ?? new List<object>()));
        
        // Date inputs
        const checkInInput = document.getElementById('checkInDate');
        const checkOutInput = document.getElementById('checkOutDate');
        const totalAmountInput = document.querySelector('input[name="TotalAmount"]');
        const roomSelect = document.getElementById('roomSelect');
        
        // Display elements
        const nightsDisplay = document.getElementById('nightsDisplay');
        const nightsDisplay2 = document.getElementById('nightsDisplay2');
        const pricePerNightEl = document.getElementById('pricePerNight');
        const calculatedTotalEl = document.getElementById('calculatedTotal');
        
        // Room data
        let selectedRoomPrice = 0;
        
        // Update room price when room changes
        if (roomSelect) {
            roomSelect.addEventListener('change', function() {
                const roomId = parseInt(this.value);
                const room = rooms.find(r => r.id === roomId);
                
                if (room) {
                    selectedRoomPrice = room.pricePerNight;
                    pricePerNightEl.textContent = '?' + selectedRoomPrice.toFixed(2);
                } else {
                    selectedRoomPrice = 0;
                    pricePerNightEl.textContent = '-';
                }
                
                calculateTotal();
            });
            
            // Initialize with current room
            const currentRoomId = parseInt(roomSelect.value);
            const currentRoom = rooms.find(r => r.id === currentRoomId);
            if (currentRoom) {
                selectedRoomPrice = currentRoom.pricePerNight;
                pricePerNightEl.textContent = '?' + selectedRoomPrice.toFixed(2);
            }
        }
        
        // Update check-out minimum when check-in changes
        if (checkInInput && checkOutInput) {
            checkInInput.addEventListener('change', function() {
                const checkInDate = new Date(this.value);
                const nextDay = new Date(checkInDate);
                nextDay.setDate(nextDay.getDate() + 1);
                
                checkOutInput.min = nextDay.toISOString().split('T')[0];
                
                if (new Date(checkOutInput.value) <= checkInDate) {
                    checkOutInput.value = nextDay.toISOString().split('T')[0];
                }
                
                calculateTotal();
            });
            
            checkOutInput.addEventListener('change', calculateTotal);
        }
        
        // Calculate nights and total
        function calculateTotal() {
            if (!checkInInput || !checkOutInput) return;
            
            const checkIn = new Date(checkInInput.value);
            const checkOut = new Date(checkOutInput.value);
            
            if (checkIn && checkOut && checkOut > checkIn) {
                const nights = Math.ceil((checkOut - checkIn) / (1000 * 60 * 60 * 24));
                
                nightsDisplay.textContent = nights + ' night' + (nights > 1 ? 's' : '');
                nightsDisplay2.textContent = nights + ' night' + (nights > 1 ? 's' : '');
                
                if (selectedRoomPrice > 0) {
                    const total = selectedRoomPrice * nights;
                    calculatedTotalEl.textContent = '?' + total.toFixed(2);
                    
                    // Auto-update total amount field
                    if (totalAmountInput) {
                        totalAmountInput.value = total.toFixed(2);
                    }
                } else {
                    calculatedTotalEl.textContent = '-';
                }
            } else {
                nightsDisplay.textContent = '-';
                nightsDisplay2.textContent = '-';
                calculatedTotalEl.textContent = '-';
            }
        }
        
        // Initial calculation
        document.addEventListener('DOMContentLoaded', function() {
            calculateTotal();
        });
    </script>
}
