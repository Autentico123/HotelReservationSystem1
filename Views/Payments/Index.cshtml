@model IEnumerable<HotelReservationSystem1.Models.Payment>
@{
    ViewData["Title"] = "Payment Management";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
   <h2>
     <i class="bi bi-cash-stack"></i> Payment Management
        </h2>
    </div>

@if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
      <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
   <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
 }

    <!-- Status Filter -->
    <div class="mb-3">
  <div class="btn-group" role="group">
  <a asp-action="Index" asp-route-status="all" 
    class="btn @(ViewBag.CurrentStatus == "all" ? "btn-primary" : "btn-outline-primary")">
        All Payments
    </a>
 <a asp-action="Index" asp-route-status="pending" 
       class="btn @(ViewBag.CurrentStatus == "pending" ? "btn-warning" : "btn-outline-warning")">
       Pending
     </a>
   <a asp-action="Index" asp-route-status="paid" 
 class="btn @(ViewBag.CurrentStatus == "paid" ? "btn-success" : "btn-outline-success")">
                Paid
   </a>
     <a asp-action="Index" asp-route-status="failed" 
     class="btn @(ViewBag.CurrentStatus == "failed" ? "btn-danger" : "btn-outline-danger")">
             Failed/Rejected
       </a>
  </div>
    </div>

    @if (Model.Any())
    {
        <div class="table-responsive">
      <table class="table table-striped table-hover">
        <thead class="table-dark">
      <tr>
       <th>Payment ID</th>
  <th>Reservation ID</th>
      <th>Customer</th>
<th>GCash Number</th>
              <th>Reference Number</th>
  <th>Amount</th>
    <th>Status</th>
  <th>Date</th>
   <th>Actions</th>
     </tr>
          </thead>
     <tbody>
 @foreach (var payment in Model)
          {
     <tr>
   <td><strong>#@payment.Id</strong></td>
  <td>
       <a asp-controller="Reservations" asp-action="Details" asp-route-id="@payment.ReservationId">
       #@payment.ReservationId
    </a>
        </td>
  <td>
        <i class="bi bi-person"></i>
      @payment.Reservation?.User?.FirstName @payment.Reservation?.User?.LastName
      </td>
         <td>
    <i class="bi bi-phone"></i>
  <small>@payment.GCashNumber</small>
     </td>
<td>
   <i class="bi bi-hash"></i>
       <code>@payment.GCashReferenceNumber</code>
   </td>
   <td><strong>?@payment.Amount.ToString("N2")</strong></td>
   <td>
    @switch (payment.PaymentStatus)
  {
  case "Pending":
  <span class="badge bg-warning text-dark"><i class="bi bi-clock"></i> @payment.PaymentStatus</span>
       break;
       case "Paid":
 <span class="badge bg-success"><i class="bi bi-check-circle"></i> @payment.PaymentStatus</span>
           break;
case "Failed":
        <span class="badge bg-danger"><i class="bi bi-x-circle"></i> @payment.PaymentStatus</span>
      break;
  default:
      <span class="badge bg-secondary">@payment.PaymentStatus</span>
     break;
         }
  </td>
 <td>
   <small>@payment.CreatedAt.ToString("MMM dd, yyyy HH:mm")</small>
        </td>
       <td>
    @if (payment.PaymentStatus == "Pending")
        {
    <div class="btn-group" role="group">
   <form asp-action="VerifyPayment" asp-route-id="@payment.Id" method="post" class="d-inline">
          @Html.AntiForgeryToken()
   <button type="submit" class="btn btn-sm btn-success" title="Verify Payment">
     <i class="bi bi-check-circle"></i> Verify
         </button>
    </form>
        <button type="button" class="btn btn-sm btn-danger" 
    data-bs-toggle="modal" data-bs-target="#rejectModal@(payment.Id)" 
    title="Reject Payment">
     <i class="bi bi-x-circle"></i> Reject
         </button>
    </div>
    
      <!-- Reject Modal -->
      <div class="modal fade" id="rejectModal@(payment.Id)" tabindex="-1">
        <div class="modal-dialog">
  <div class="modal-content">
 <div class="modal-header">
       <h5 class="modal-title">Reject Payment #@payment.Id</h5>
 <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
       </div>
           <form asp-action="RejectPayment" asp-route-id="@payment.Id" method="post">
        @Html.AntiForgeryToken()
        <div class="modal-body">
     <div class="mb-3">
    <label class="form-label">Reason for rejection:</label>
   <textarea name="reason" class="form-control" rows="3" required 
  placeholder="Enter reason for rejecting this payment..."></textarea>
   </div>
         </div>
     <div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
       <button type="submit" class="btn btn-danger">Reject Payment</button>
   </div>
   </form>
   </div>
   </div>
       </div>
     }
  else
       {
    <span class="text-muted">-</span>
      }
  </td>
       </tr>
        }
  </tbody>
     </table>
        </div>
 }
    else
    {
   <div class="alert alert-info text-center py-5">
  <div class="display-1 mb-3">??</div>
     <h4>No payments found</h4>
   <p class="text-muted">
      @if (ViewBag.CurrentStatus == "all")
        {
      <text>No payments have been submitted yet.</text>
      }
     else
     {
  <text>No @ViewBag.CurrentStatus payments found.</text>
  }
  </p>
  </div>
 }
</div>
